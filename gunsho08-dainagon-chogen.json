 "poems": [
  {
   "seq": "1",
   "text": "たちてゆく春をおしめと夏衣きたれはこれもめつらしき哉",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "みな人もけふや衣をかへつらんひとへに夏のきぬと思へは",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "山吹の花の匂にあひてこそ非手のあるしとならまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "浪のよるかけさへ花と見ゆる哉さかりにさけるゐての山吹",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "いつかたの梢咲らむ藤波の春と夏とのきしをへたてゝ",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "紫の雲のたつとも見ゆる哉こたかき松にか〓る藤波",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "春過しかきねなれとも卯花のさかりにきてはとまりぬるかな",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "うの花の盛になれはよそに見ししつの垣根も過うかりけり",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "をしこめていのりかけつる葵草しめのほかなる人もたのまむ",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "けふみれはかけて歸らぬ人そなきあふひそ神のしるしなり鳬",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "程もなくしけきうへ田の早苗哉ましるくさはのとりあへぬ迄",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "うちかへす程もへなくに小山田の早苗はけふそ色にとりける",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "雲ゐよりなく一聲は子規きけとも安きそらのなきかな",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "またきかてまちつるよりも子規おほつかなきはよはの一聲",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "ひまもなく叩くくひなに蜑のとの驚きなからあけぬ夜はなし",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "夏の夜のあけぬかきりは月影にた〓くくひなの音のみそする",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あたなりし花をもこひしくれ竹のかはらぬ色をわか友とせん",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "吳竹のふしのしけくもみゆる哉かそへもやらぬちよやしる覽",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "せきれたるいはまの水の濁らぬにのとかに月の影をこそみれ",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "せきいれては鏡とそ見る朝ことにのとかにすめる水の流を",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
